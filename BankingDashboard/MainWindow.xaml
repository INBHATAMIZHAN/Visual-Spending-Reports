<Window x:Class="BankingDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TEAM-9 Banking Analytics Dashboard"
        Height="760" Width="1200" Background="#EDF3F7" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0F172A" CornerRadius="0,18,18,0">
            <StackPanel Margin="18,20,18,20">
                <TextBlock Text="KITE BANK" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,10,0,30" HorizontalAlignment="Center"/>
                <Button x:Name="OverviewButton" Content="Overview" Click="OverviewButton_Click" Background="#1E293B" Foreground="White" BorderThickness="0" Padding="12" Margin="0,5" HorizontalContentAlignment="Left" FontSize="14" FontWeight="SemiBold"/>
                <Button x:Name="TransactionsButton" Content="Transactions" Click="TransactionsButton_Click" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="12" Margin="0,5" HorizontalContentAlignment="Left" FontSize="14"/>
                <Button x:Name="ReportsButton" Content="Visual Reports" Click="ReportsButton_Click" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="12" Margin="0,5" HorizontalContentAlignment="Left" FontSize="14"/>
                <Button x:Name="AccountsButton" Content="Accounts" Click="AccountsButton_Click" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="12" Margin="0,5" HorizontalContentAlignment="Left" FontSize="14"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="25">
            <Grid x:Name="OverviewPanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="Spending Habits Analysis" FontSize="30" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Banking overview and transaction breakdown" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>

                    <Border Background="#FFFFFF" CornerRadius="12" Margin="0,14,0,0" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Month:" VerticalAlignment="Center" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <ComboBox x:Name="MonthFilter" Grid.Column="1" Width="140" Margin="0,0,12,0" SelectedIndex="0"/>

                            <TextBlock Grid.Column="2" Text="Category:" VerticalAlignment="Center" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CategoryFilter" Grid.Column="3" Width="150" Margin="0,0,12,0" SelectedIndex="0"/>

                            <Button Grid.Column="4" x:Name="ApplyFiltersButton" Content="Apply Filters" Width="130" Background="#2563EB" Foreground="White" BorderThickness="0" Click="ApplyFiltersButton_Click" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#2563EB" CornerRadius="14" Margin="0,0,10,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Total Spend" Foreground="#DBEAFE" FontSize="12"/>
                            <TextBlock x:Name="TotalSpendValue" Text="₹0.00" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#0EA5E9" CornerRadius="14" Margin="0,0,10,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Average / Txn" Foreground="#E0F2FE" FontSize="12"/>
                            <TextBlock x:Name="AverageSpendValue" Text="₹0.00" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#10B981" CornerRadius="14" Margin="0,0,10,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Top Category" Foreground="#D1FAE5" FontSize="12"/>
                            <TextBlock x:Name="TopCategoryValue" Text="-" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="#F59E0B" CornerRadius="14" Padding="16">
                        <StackPanel>
                            <TextBlock Text="This Month" Foreground="#FEF3C7" FontSize="12"/>
                            <TextBlock x:Name="NetIncomeValue" Text="₹0.00" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="16" Margin="0,0,10,0" Padding="16">
                        <Grid>
                            <TextBlock Text="Category Bar Graph" FontWeight="SemiBold" Foreground="#1E293B" FontSize="16" Margin="0,0,0,10"/>
                            <TextBlock Text="Monthly spending by category" Foreground="#64748B" FontSize="11" Margin="0,24,0,0"/>
                            <Canvas x:Name="BarCanvas" Height="220" Width="420" Margin="0,40,0,0" Background="#F8FAFC"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Expense Distribution" FontWeight="SemiBold" Foreground="#1E293B" FontSize="16" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="0" Text="Share of total spend" Foreground="#64748B" FontSize="11" Margin="0,24,0,0"/>
                            <Canvas x:Name="PieCanvas" Grid.Row="1" Height="170" Width="260" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>
                            <WrapPanel x:Name="PieLegend" Grid.Row="1" Margin="0,185,0,0" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Background="White" CornerRadius="16" Padding="10">
                    <Grid>
                        <TextBlock Text="Recent Transactions" FontWeight="SemiBold" Foreground="#1E293B" FontSize="16" Margin="10,8,0,10"/>
                        <DataGrid x:Name="TransactionGrid" Margin="0,35,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                              RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" Background="White" Foreground="#0F172A">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                                <DataGridTextColumn Header="Amount" Width="150">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Amount" StringFormat="{}{0:C}"/>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:MMM dd, yyyy}}" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="TransactionsPanel" Visibility="Collapsed" Background="#F8FAFC">
                <Border Background="White" CornerRadius="16" Padding="20" Margin="10">
                    <Grid>
                        <TextBlock Text="Transaction History" FontSize="28" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,18"/>
                        <DataGrid x:Name="FullTransactionGrid" Margin="0,45,0,0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                                <DataGridTextColumn Header="Payment Method" Binding="{Binding Method}" Width="160"/>
                                <DataGridTextColumn Header="Amount" Width="160">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Amount" StringFormat="{}{0:C}"/>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:MMM dd, yyyy}}" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="ReportsPanel" Visibility="Collapsed" Background="#F8FAFC">
                <Border Background="White" CornerRadius="16" Padding="20" Margin="10">
                    <StackPanel>
                        <TextBlock Text="Visual Reports" FontSize="28" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,18"/>
                        <TextBlock Text="Monthly category breakdown and spending trends" Foreground="#64748B" FontSize="14" Margin="0,0,0,16"/>
                        <ListView x:Name="ReportListView" BorderThickness="0" Background="Transparent">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Category" DisplayMemberBinding="{Binding Category}" Width="200"/>
                                    <GridViewColumn Header="Spent" DisplayMemberBinding="{Binding SpentText}" Width="180"/>
                                    <GridViewColumn Header="Share" DisplayMemberBinding="{Binding ShareText}" Width="120"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="AccountsPanel" Visibility="Collapsed" Background="#F8FAFC">
                <Border Background="White" CornerRadius="16" Padding="20" Margin="10">
                    <StackPanel>
                        <TextBlock Text="Accounts" FontSize="28" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,18"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#2563EB" CornerRadius="14" Padding="16" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Primary Savings" Foreground="#DBEAFE" FontSize="12"/>
                                    <TextBlock x:Name="SavingsBalance" Text="₹0.00" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#10B981" CornerRadius="14" Padding="16" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Checking" Foreground="#D1FAE5" FontSize="12"/>
                                    <TextBlock x:Name="CheckingBalance" Text="₹0.00" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#F59E0B" CornerRadius="14" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Credit Limit" Foreground="#FEF3C7" FontSize="12"/>
                                    <TextBlock x:Name="CreditBalance" Text="₹0.00" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <DataGrid x:Name="AccountGrid" Margin="0,18,0,0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Account" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="160"/>
                                <DataGridTextColumn Header="Balance" Width="180">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Balance" StringFormat="{}{0:C}"/>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
